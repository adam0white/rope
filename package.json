{
  "name": "rope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Rope: lead five Human Framework people up a mountain and back. Every one of them can say no.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "stamp-release && vite build",
    "preview": "vite preview",
    "test": "vitest run --testTimeout=30000",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "measure": "node scripts/measure.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "check:lane": "npm run check"
  },
  "dependencies": {
    "@adam0white/human-framework": "2.8.0",
    "@adam0white/lab-client": "file:vendor/adam0white-lab-client-0.4.2.tgz",
    "pixi.js": "8.22.0",
    "@adam0white/lab-kit": "file:vendor/adam0white-lab-kit-0.5.2.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents": false
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
